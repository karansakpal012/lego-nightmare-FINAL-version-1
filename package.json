{
  "name": "lego-nightmare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LEGO-inspired first-person horror escape-room game",
  "author": "LEGO Nightmare Team",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/inventory.test.js",
    "electron": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.example.legonightmare",
    "productName": "LEGO Nightmare",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
